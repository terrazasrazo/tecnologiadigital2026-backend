# Entorno
NODE_ENV=development

# Servidor
PORT=3000
HOST=0.0.0.0

# URL del Frontend (Astro) usada para construir enlaces en los correos
FRONTEND_URL=http://localhost:4321

# Base de datos (solo MySQL en este momento)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eventos
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Token de sesión
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

# Correo SMTP. Si SMTP_HOST queda vacío, los correos se registran en el log (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM=Eventos <no-reply@localhost>

# CORS: orígenes permitidos separados por coma (origen del Frontend en Astro)
CORS_ORIGINS=

# Archivos subidos (fotografías de ponentes)
UPLOADS_DIR=storage/uploads
UPLOADS_PUBLIC_PATH=/uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Zona horaria del evento: desfase respecto a UTC en minutos (ej. CDMX = -360)
EVENT_TZ_OFFSET_MINUTES=0

# Logs
LOG_LEVEL=debug