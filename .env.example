# Entorno
NODE_ENV=development

# Servidor
PORT=3000
HOST=0.0.0.0

# Base de datos (solo MySQL en este momento)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eventos
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Token de sesión (se usará a partir de M1)
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Correo SMTP (se usará a partir de M2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM=

# CORS: orígenes permitidos separados por coma (origen del Frontend en Astro)
CORS_ORIGINS=

# Logs
LOG_LEVEL=debug