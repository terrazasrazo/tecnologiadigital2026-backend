# Entorno
NODE_ENV=development

# Servidor
PORT=3000
HOST=0.0.0.0

# Prefijo público (subdirectorio) bajo el que se sirve la API.
# Déjalo vacío para servir en la raíz. En este despliegue:
#   BACKEND  -> https://lat.bunam.unam.mx/td2026        => BASE_PATH=/td2026
#   Endpoints-> https://lat.bunam.unam.mx/td2026/api/...
#   Subidas  -> https://lat.bunam.unam.mx/td2026/uploads/...
BASE_PATH=/td2026

# URL pública del FRONTEND (Astro) usada para los enlaces en los correos
# (verificación, reseteo, constancias). NO es la URL del backend.
# El backend se publica en https://lat.bunam.unam.mx/td2026 (ver BASE_PATH).
FRONTEND_URL=http://localhost:4321

# Base de datos (solo MySQL en este momento)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eventos
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Token de sesión
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

# Correo SMTP. Si SMTP_HOST queda vacío, los correos se registran en el log (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM=Eventos <no-reply@localhost>
MAIL_MAX_RETRIES=2
MAIL_RETRY_DELAY_MS=500
APP_NAME=Tecnología Digital

# CORS: orígenes del FRONTEND permitidos, separados por coma.
# Es el origen del frontend (p. ej. https://midominio.com), no el del backend.
# Vacío = permitir cualquier origen.
CORS_ORIGINS=

# Usuario admin inicial (seeder `seed-dev-admin`). En producción define estos
# valores con credenciales seguras; en desarrollo se usan los de por defecto.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_LAST_NAME=

# Archivos subidos (fotografías de ponentes)
UPLOADS_DIR=storage/uploads
UPLOADS_PUBLIC_PATH=/uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Zona horaria del evento: desfase respecto a UTC en minutos (ej. CDMX = -360)
EVENT_TZ_OFFSET_MINUTES=0

# Constancias en PDF. PDF_PROVIDER: wkhtmltopdf | gotenberg | stub (pruebas).
PDF_PROVIDER=wkhtmltopdf
WKHTMLTOPDF_PATH=wkhtmltopdf
GOTENBERG_URL=http://localhost:3000
PDF_TIMEOUT_MS=30000

# Directorio privado donde se guardan los PDF de constancias
CERTIFICATES_DIR=storage/certificates

# Logs
LOG_LEVEL=debug